# .env.example — 환경변수 (실제 값은 .env에, .env는 커밋 금지)
# 로컬: uvicorn app.main:app --env-file .env   /   배포(Render): Environment에 등록

# MLflow Tracking 서버 (로컬: http://127.0.0.1:5000, 배포: ngrok 등으로 노출한 주소)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# 에러 발생 시 GitHub Issue 자동생성 (둘 다 있어야 동작, 없으면 조용히 skip)
GH_REPO=jlib245/qec_dashboard
GH_TOKEN=
