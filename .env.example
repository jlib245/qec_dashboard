# .env.example — 필요한 환경변수 목록 (실제 값은 .env에, .env는 커밋 금지)
# 로컬: `uvicorn app.main:app --env-file .env`  /  배포(Render): 대시보드 Environment에 등록

# 디코더 모드: mwpm | neural
MODEL_MODE=mwpm

# MLflow registry 위치 (로컬: sqlite:///mlruns.db, 배포: ngrok URL)
MLFLOW_TRACKING_URI=

# 로드할 등록 모델/alias
MODEL_URI=models:/mlp_d3@champion

# wrapper 재조립용 config (학습 config와 geometry 일치해야 함)
BUNDLED_CONFIG=ml/configs/mlp_d3.yaml

# 에러 발생 시 GitHub Issue 자동생성 (둘 다 있어야 동작, 없으면 조용히 skip)
GH_REPO=owner/repo
GH_TOKEN=
